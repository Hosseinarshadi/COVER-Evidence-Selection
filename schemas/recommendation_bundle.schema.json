{
 "$defs": {
  "ContrastCard": {
   "additionalProperties": false,
   "properties": {
    "schema_version": {
     "default": "cover-v3.0",
     "title": "Schema Version",
     "type": "string"
    },
    "case_id": {
     "title": "Case Id",
     "type": "string"
    },
    "state_id": {
     "title": "State Id",
     "type": "string"
    },
    "turn": {
     "title": "Turn",
     "type": "integer"
    },
    "arm": {
     "title": "Arm",
     "type": "string"
    },
    "query_id": {
     "title": "Query Id",
     "type": "string"
    },
    "query_language": {
     "const": "catalog_check",
     "default": "catalog_check",
     "title": "Query Language",
     "type": "string"
    },
    "query_text": {
     "title": "Query Text",
     "type": "string"
    },
    "feasible": {
     "title": "Feasible",
     "type": "boolean"
    },
    "feasibility_reason": {
     "title": "Feasibility Reason",
     "type": "string"
    },
    "purpose": {
     "default": "candidate",
