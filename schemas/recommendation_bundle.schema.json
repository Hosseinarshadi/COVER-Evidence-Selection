     "default": "LLM_prediction",
     "enum": [
      "LLM_prediction",
      "missing"
     ],
     "title": "Source",
     "type": "string"
    },
    "uncertain": {
     "title": "Uncertain",
     "type": "boolean"
    }
   },
   "required": [
    "hypothesis_id",
    "predicted_observation",
    "probability",
    "uncertain"
   ],
   "title": "PredictedObservation",
   "type": "object"
  },
  "Rejected": {
   "additionalProperties": false,
