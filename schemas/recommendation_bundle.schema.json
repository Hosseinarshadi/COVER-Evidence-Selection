      "challenge_leading_hunch",
      "independent_corroboration",
      "alternative_rival_check",
      "exploratory",
      "nondiscriminating_fallback",
      "unranked_option",
      "candidate"
     ],
     "title": "Purpose",
     "type": "string"
    },
    "leading_hypothesis_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
