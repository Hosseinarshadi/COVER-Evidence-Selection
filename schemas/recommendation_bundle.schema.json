    },
    "rival_hypothesis_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rival Hypothesis Id"
    },
    "if_leading_hypothesis": {
     "anyOf": [
      {
       "$ref": "#/$defs/PredictedObservation"
      },
      {
       "type": "null"
      }
     ],
     "default": null
