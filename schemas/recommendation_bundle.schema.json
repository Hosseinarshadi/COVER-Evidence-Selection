    "previously_checked": {
     "default": false,
     "title": "Previously Checked",
     "type": "boolean"
    },
    "discriminating": {
     "default": false,
     "title": "Discriminating",
     "type": "boolean"
    },
    "could_undermine_leader": {
     "default": false,
     "title": "Could Undermine Leader",
     "type": "boolean"
    },
    "corroborates_leader": {
     "default": false,
     "title": "Corroborates Leader",
     "type": "boolean"
