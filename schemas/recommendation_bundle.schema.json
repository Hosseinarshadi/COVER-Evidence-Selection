     "type": "integer"
    },
    "explanation": {
     "default": "",
     "title": "Explanation",
     "type": "string"
    },
    "limitations": {
     "items": {
      "type": "string"
     },
     "title": "Limitations",
     "type": "array"
    },
    "warnings": {
     "items": {
      "type": "string"
     },
     "title": "Warnings",
     "type": "array"
    },
    "human_choice": {
     "default": null,
     "title": "Human Choice",
     "type": "null"
    },
    "simulated_choice": {
     "anyOf": [
      {
       "enum": [
        "selected_top1",
        "not_selected"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Simulated Choice"
    }
   },
   "required": [
    "case_id",
    "state_id",
    "turn",
    "arm",
    "query_id",
    "query_text",
    "feasible",
    "feasibility_reason",
    "leading_hypothesis_id"
   ],
   "title": "ContrastCard",
   "type": "object"
  },
